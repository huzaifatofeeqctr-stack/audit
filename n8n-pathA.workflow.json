    {
      "parameters": {
        "jsCode": "// Parse the Rattle alert -> opp name (for reference), channel, thread ts, raw text.\nconst m = $input.item.json;\nconst text = m.text || '';\nconst nameMatch = text.match(/\\*Name:\\*\\s*(.+)/);\nif (!nameMatch) { throw new Error('No *Name:* line found in Rattle message.'); }\nlet name = nameMatch[1].trim().replace(/^<https?:[^|]+\\|/, '').replace(/>$/, '').trim();\nreturn {\n  opp_name: name,\n  channel_id: m.channel,\n  thread_ts: m.thread_ts || m.ts,\n  text: text\n};\n"
      },
