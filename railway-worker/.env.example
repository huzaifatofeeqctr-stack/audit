# Railway worker — environment variables. Copy to .env (gitignored) and fill in.
# In Railway, set these under: service → Variables.

# --- Salesforce (connected app, client_credentials grant) ---
SF_INSTANCE_URL=https://postscript.my.salesforce.com
SF_CLIENT_ID=your-salesforce-consumer-key
SF_CLIENT_SECRET=your-salesforce-consumer-secret

# --- SpotDraft Public API (header auth) ---
SPOTDRAFT_CLIENT_ID=your-spotdraft-client-id
SPOTDRAFT_CLIENT_SECRET=your-spotdraft-client-secret

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
AUDIT_MODEL=claude-opus-4-8

# --- Slack (the app already on n8n; needs chat:write + reactions:write) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_BOT_USER_ID=U0B8RPYQ2GL

# --- optional: raw GitHub URL of SKILL.md (defaults to this branch) ---
# SKILL_SOURCE=https://raw.githubusercontent.com/huzaifatofeeqctr-stack/audit/claude/kind-tesla-9l7gw/SKILL.md
